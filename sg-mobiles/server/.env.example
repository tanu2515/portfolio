PORT=5000
# Use a real MongoDB (local or Atlas). Set to "memory" to run an in-memory DB (data resets on restart).
MONGO_URI=mongodb://127.0.0.1:27017/sgmobiles
JWT_SECRET=change-this-secret
CLIENT_URL=http://localhost:5173
ADMIN_EMAIL=admin@sgmobiles.com
ADMIN_PASSWORD=admin123

# Online payments (Razorpay). Leave empty to offer only pay-on-delivery.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Email (order confirmations, shipping updates, password reset). Leave SMTP_HOST empty to print emails to the console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="SG Mobiles <no-reply@sgmobiles.com>"
